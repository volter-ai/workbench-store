{
  "id": "flowise",
  "name": "Flowise",
  "icon": "Workflow",
  "tint": "#7b61ff",
  "repo": "https://github.com/FlowiseAI/Flowise",
  "install": "mkdir -p ../flowise-bin.noindex && cd ../flowise-bin.noindex && { [ -f package.json ] || npm init -y >/dev/null; } && npm install --no-audit --no-fund flowise@latest",
  "start": "./node_modules/.bin/flowise start",
  "port": 5306,
  "world": "workbench/box",
  "egress": ["https://tiktoken.pages.dev"],
  "vendors": [
    "anthropic",
    "openai"
  ],
  "window": {
    "w": 1200,
    "h": 780
  },
  "notes": "LLM flow builder; runs SEALED in a twin world — AI vendors are twins, no real keys",
  "cwd": "programs/flowise-bin.noindex",
  "auth": {
    "login": {
      "path": "/api/v1/auth/login",
      "json": {
        "email": "${email}",
        "password": "${password}"
      }
    },
    "register": {
      "path": "/api/v1/account/register",
      "json": {
        "user": {
          "name": "Owner",
          "email": "${email}",
          "credential": "${password}"
        }
      }
    },
    "store": [
      {
        "key": "isAuthenticated",
        "value": "true"
      },
      {
        "key": "user",
        "from": "."
      },
      {
        "key": "permissions",
        "from": "permissions"
      },
      {
        "key": "features",
        "from": "features"
      }
    ],
    "seed": [
      {
        "check": "/api/v1/credentials?credentialName=openAIApi",
        "path": "/api/v1/credentials",
        "update": "/api/v1/credentials/{id}",
        "headers": {
          "x-request-from": "internal"
        },
        "json": {
          "name": "OpenAI (this box's World)",
          "credentialName": "openAIApi",
          "plainDataObj": {
            "openAIApiKey": "${env:OPENAI_API_KEY}"
          }
        }
      },
      {
        "check": "/api/v1/credentials?credentialName=anthropicApi",
        "path": "/api/v1/credentials",
        "update": "/api/v1/credentials/{id}",
        "headers": {
          "x-request-from": "internal"
        },
        "json": {
          "name": "Anthropic (this box's World)",
          "credentialName": "anthropicApi",
          "plainDataObj": {
            "anthropicApiKey": "${env:ANTHROPIC_API_KEY}"
          }
        }
      }
    ]
  }
}